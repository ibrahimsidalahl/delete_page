<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تحميل تطبيق عناب</title>

    <style>
        body {
            font-family: sans-serif;
            background-color: #f8f8f8;
            margin: 0;
            padding: 0;
            text-align: center;
        }

        .container {
            margin-top: 50px;
        }

        .logo {
            width: 150px;
            height: 150px;
            border-radius: 20px;
        }

        h1 {
            color: #810D18;
            margin-top: 20px;
        }

        p {
            font-size: 20px;
            color: #333;
        }

        .buttons {
            margin-top: 30px;
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .store-btn img {
            height: 60px;
        }
    </style>
</head>
<body>

<div class="container">
    <!-- App Logo -->
    <img src="https://drive.google.com/uc?export=view&id=1mNbyjKPVuLhpYqCpHnWU8uLk_X4ZF9iH" 
         alt="شعار تطبيق عناب" class="logo">

    <!-- App Name -->
    <h1>تطبيق عناب</h1>

    <!-- Slogan -->
    <p>عناب هيوصلك لحد الباب</p>

    <!-- Download Buttons -->
    <div class="buttons">
        <!-- Google Play -->
        <a class="store-btn" href="https://play.google.com/store/apps/details?id=com.elragolel3nab.delivery">
            <img src="https://upload.wikimedia.org/wikipedia/commons/7/78/Google_Play_Store_badge_EN.svg" 
                 alt="تحميل من Google Play">
        </a>

        <!-- App Store (Not Yet Live) -->
        <a class="store-btn" href="#">
            <img src="https://upload.wikimedia.org/wikipedia/commons/6/67/Download_on_the_App_Store_Badge_AR.svg" 
                 alt="تحميل من App Store">
        </a>
    </div>
</div>

</body>
</html>
